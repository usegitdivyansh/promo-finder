{
 "episode": 2,
 "duration_sec": 131.0,
 "lines": [
  {
   "id": "E2_L0",
   "start": 0.0,
   "end": 3.0,
   "type": "dialogue",
   "speaker": "HARISH DESAI",
   "text": "It's about your father.",
   "scene_id": 1,
   "is_recap": true,
   "estimated_time": false
  },
  {
   "id": "E2_L1",
   "start": 3.0,
   "end": 5.0,
   "type": "action",
   "speaker": null,
   "text": "Mira freezes.",
   "scene_id": 1,
   "is_recap": true,
   "estimated_time": false
  },
  {
   "id": "E2_L2",
   "start": 5.0,
   "end": 7.0,
   "type": "scene",
   "speaker": null,
   "text": "INT. DESAI'S CAR - NIGHT - MOVING",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L3",
   "start": 7.0,
   "end": 11.0,
   "type": "action",
   "speaker": null,
   "text": "Rain streaks the windows. Mira sits stiffly, clutching the cracked frame.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L4",
   "start": 11.0,
   "end": 17.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "My father walked out before I was born. Whatever he wants, the answer is no.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L5",
   "start": 17.0,
   "end": 22.0,
   "type": "dialogue",
   "speaker": "DESAI",
   "text": "He didn't walk out, Miss Kapoor. He was never told you existed.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L6",
   "start": 22.0,
   "end": 28.0,
   "type": "action",
   "speaker": null,
   "text": "Desai hands her a thick cream envelope sealed with red wax. The seal shows an anchor and the letters R.S.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L7",
   "start": 28.0,
   "end": 32.0,
   "type": "dialogue",
   "speaker": "DESAI",
   "text": "Everything is in here. Read it when you are ready.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L8",
   "start": 32.0,
   "end": 35.0,
   "type": "action",
   "speaker": null,
   "text": "Mira puts the envelope in her bag without opening it.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L9",
   "start": 35.0,
   "end": 38.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "Stop the car. I'll walk from here.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L10",
   "start": 38.0,
   "end": 40.0,
   "type": "scene",
   "speaker": null,
   "text": "INT. MEHTA GROUP - DESIGN OFFICE - DAY",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L11",
   "start": 40.0,
   "end": 45.0,
   "type": "action",
   "speaker": null,
   "text": "Mira, a bruise on her cheek, sits at a cramped desk sketching a hotel lobby.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L12",
   "start": 45.0,
   "end": 48.0,
   "type": "action",
   "speaker": null,
   "text": "Tanya walks in carrying Mira's portfolio.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L13",
   "start": 48.0,
   "end": 53.0,
   "type": "dialogue",
   "speaker": "TANYA",
   "text": "Mira, Mrs. Mehta wants to see the lobby designs. I'll take them up for you.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L14",
   "start": 53.0,
   "end": 56.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "Those are mine. I'll present them myself.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L15",
   "start": 56.0,
   "end": 59.0,
   "type": "action",
   "speaker": null,
   "text": "Leela Mehta enters with two security guards.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L16",
   "start": 59.0,
   "end": 63.0,
   "type": "dialogue",
   "speaker": "MRS. MEHTA",
   "text": "You won't present anything. You're fired.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L17",
   "start": 63.0,
   "end": 65.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "On what grounds?",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L18",
   "start": 65.0,
   "end": 70.0,
   "type": "dialogue",
   "speaker": "MRS. MEHTA",
   "text": "Theft. Tanya found our client files on your laptop.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L19",
   "start": 70.0,
   "end": 73.0,
   "type": "action",
   "speaker": null,
   "text": "Mira turns to Tanya. Tanya won't meet her eyes.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L20",
   "start": 73.0,
   "end": 76.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "Tanya. Tell her that's a lie.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L21",
   "start": 76.0,
   "end": 80.0,
   "type": "dialogue",
   "speaker": "TANYA",
   "text": "I'm sorry, Mira. I had to tell the truth.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L22",
   "start": 80.0,
   "end": 85.0,
   "type": "action",
   "speaker": null,
   "text": "A guard dumps Mira's belongings into a cardboard box in front of the whole office.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L23",
   "start": 85.0,
   "end": 90.0,
   "type": "dialogue",
   "speaker": "MRS. MEHTA",
   "text": "And the new head of design is Ms. Sethi. Congratulations, Tanya.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L24",
   "start": 90.0,
   "end": 93.0,
   "type": "action",
   "speaker": null,
   "text": "The office applauds. Tanya smiles.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L25",
   "start": 93.0,
   "end": 95.0,
   "type": "scene",
   "speaker": null,
   "text": "EXT. MEHTA GROUP TOWER - STEPS - DAY",
   "scene_id": 4,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L26",
   "start": 95.0,
   "end": 102.0,
   "type": "action",
   "speaker": null,
   "text": "Mira sits on the steps with her box. Her phone buzzes. A text from Arjun: \"Don't call me for a while.\"",
   "scene_id": 4,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L27",
   "start": 102.0,
   "end": 106.0,
   "type": "action",
   "speaker": null,
   "text": "She laughs bitterly, then pulls the cream envelope out of her bag.",
   "scene_id": 4,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L28",
   "start": 106.0,
   "end": 109.0,
   "type": "action",
   "speaker": null,
   "text": "She breaks the red wax seal.",
   "scene_id": 4,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L29",
   "start": 109.0,
   "end": 117.0,
   "type": "action",
   "speaker": null,
   "text": "Inside: a legal document and an old photograph of a young woman holding a baby. On the back: \"Asha and our daughter. V.\"",
   "scene_id": 4,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L30",
   "start": 117.0,
   "end": 120.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "Asha... that's my mother.",
   "scene_id": 4,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L31",
   "start": 120.0,
   "end": 125.0,
   "type": "action",
   "speaker": null,
   "text": "She unfolds the document. Her eyes widen. Her hands start to shake.",
   "scene_id": 4,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L32",
   "start": 125.0,
   "end": 129.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "(whispering) This can't be true.",
   "scene_id": 4,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E2_L33",
   "start": 129.0,
   "end": 131.0,
   "type": "direction",
   "speaker": null,
   "text": "CUT TO BLACK.",
   "scene_id": 4,
   "is_recap": false,
   "estimated_time": false
  }
 ],
