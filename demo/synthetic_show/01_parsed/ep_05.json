{
 "episode": 5,
 "duration_sec": 121.0,
 "lines": [
  {
   "id": "E5_L0",
   "start": 0.0,
   "end": 5.0,
   "type": "dialogue",
   "speaker": "MIRA RAO",
   "text": "And my first decision as chair... is about the Mehta Group.",
   "scene_id": 1,
   "is_recap": true,
   "estimated_time": false
  },
  {
   "id": "E5_L1",
   "start": 5.0,
   "end": 7.0,
   "type": "scene",
   "speaker": null,
   "text": "INT. RAO SHIPPING - BOARDROOM - DAY",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L2",
   "start": 7.0,
   "end": 12.0,
   "type": "action",
   "speaker": null,
   "text": "Glass walls, the harbour beyond. Mira sits at the head of the table. Desai at her side.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L3",
   "start": 12.0,
   "end": 17.0,
   "type": "action",
   "speaker": null,
   "text": "Leela, Arjun and Tanya are led in by an assistant. Nobody offers them a seat.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L4",
   "start": 17.0,
   "end": 23.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "Rao Shipping is withdrawing all investment from the Mehta Group. Effective today.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L5",
   "start": 23.0,
   "end": 27.0,
   "type": "dialogue",
   "speaker": "ARJUN",
   "text": "You can't do that. Three hundred people work for us.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L6",
   "start": 27.0,
   "end": 31.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "Two hundred and ninety-nine. I was fired, remember?",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L7",
   "start": 31.0,
   "end": 33.0,
   "type": "dialogue",
   "speaker": "LEELA",
   "text": "You ungrateful little-",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L8",
   "start": 33.0,
   "end": 37.0,
   "type": "action",
   "speaker": null,
   "text": "Leela raises her hand to slap Mira. Mira catches her wrist mid-air.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L9",
   "start": 37.0,
   "end": 40.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "Not this time, Mrs. Mehta.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L10",
   "start": 40.0,
   "end": 44.0,
   "type": "action",
   "speaker": null,
   "text": "She lets go. Leela stumbles back into a chair.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L11",
   "start": 44.0,
   "end": 47.0,
   "type": "action",
   "speaker": null,
   "text": "Arjun drops to one knee beside Mira's chair.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L12",
   "start": 47.0,
   "end": 54.0,
   "type": "dialogue",
   "speaker": "ARJUN",
   "text": "Mira, I made a mistake. Tanya means nothing. Please. Give me another chance.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L13",
   "start": 54.0,
   "end": 58.0,
   "type": "action",
   "speaker": null,
   "text": "Mira places the pearl earring on the table in front of him.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L14",
   "start": 58.0,
   "end": 63.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "You left this in your car. Give it back to its owner.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L15",
   "start": 63.0,
   "end": 66.0,
   "type": "action",
   "speaker": null,
   "text": "Tanya stares at the earring, then at Arjun.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L16",
   "start": 66.0,
   "end": 71.0,
   "type": "dialogue",
   "speaker": "TANYA",
   "text": "Means nothing? I'm carrying your child, Arjun.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L17",
   "start": 71.0,
   "end": 74.0,
   "type": "action",
   "speaker": null,
   "text": "Arjun turns white. Leela gasps.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L18",
   "start": 74.0,
   "end": 80.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "Then you two have a lot to talk about. Mr. Desai, show them out.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L19",
   "start": 80.0,
   "end": 82.0,
   "type": "scene",
   "speaker": null,
   "text": "INT. RAO SHIPPING - MIRA'S OFFICE - NIGHT",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L20",
   "start": 82.0,
   "end": 87.0,
   "type": "action",
   "speaker": null,
   "text": "Mira alone at her father's desk. She finally unties the bundle of letters.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L21",
   "start": 87.0,
   "end": 91.0,
   "type": "action",
   "speaker": null,
   "text": "She reads the first one. Her eyes fill with tears.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L22",
   "start": 91.0,
   "end": 97.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "(reading) \"Asha, if anything happens to me, it was not an accident.\"",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L23",
   "start": 97.0,
   "end": 100.0,
   "type": "action",
   "speaker": null,
   "text": "Her phone lights up. Unknown number.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L24",
   "start": 100.0,
   "end": 102.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "Hello?",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L25",
   "start": 102.0,
   "end": 108.0,
   "type": "dialogue",
   "speaker": "VOICE",
   "text": "(distorted) Miss Rao. Your father didn't die of a heart attack.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L26",
   "start": 108.0,
   "end": 114.0,
   "type": "dialogue",
   "speaker": "VOICE",
   "text": "He was murdered. And his killer was at your gala last night.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L27",
   "start": 114.0,
   "end": 119.0,
   "type": "action",
   "speaker": null,
   "text": "The line goes dead. Mira stares at her reflection in the dark window.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E5_L28",
   "start": 119.0,
   "end": 121.0,
   "type": "direction",
   "speaker": null,
   "text": "CUT TO BLACK.",
   "scene_id": 3,
   "is_recap": false,
   "estimated_time": false
  }
 ],
