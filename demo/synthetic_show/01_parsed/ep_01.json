{
 "episode": 1,
 "duration_sec": 128.0,
 "lines": [
  {
   "id": "E1_L0",
   "start": 0.0,
   "end": 2.0,
   "type": "scene",
   "speaker": null,
   "text": "INT. MEHTA MANSION - BALLROOM - NIGHT",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L1",
   "start": 2.0,
   "end": 5.0,
   "type": "action",
   "speaker": null,
   "text": "Crystal chandeliers. Guests in silk and diamonds raise champagne flutes.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L2",
   "start": 5.0,
   "end": 9.0,
   "type": "action",
   "speaker": null,
   "text": "MIRA KAPOOR, in a simple cotton saree, stands alone near the stage holding a small wrapped gift.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L3",
   "start": 9.0,
   "end": 14.0,
   "type": "dialogue",
   "speaker": "LEELA MEHTA",
   "text": "(into the microphone) Thank you all for coming to celebrate my son Arjun.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L4",
   "start": 14.0,
   "end": 17.0,
   "type": "action",
   "speaker": null,
   "text": "Leela spots Mira. Her smile vanishes.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L5",
   "start": 17.0,
   "end": 21.0,
   "type": "dialogue",
   "speaker": "LEELA MEHTA",
   "text": "And of course... his fiancée. Mira, come up here, dear.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L6",
   "start": 21.0,
   "end": 24.0,
   "type": "action",
   "speaker": null,
   "text": "Mira climbs the steps. Guests whisper.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L7",
   "start": 24.0,
   "end": 27.0,
   "type": "dialogue",
   "speaker": "LEELA MEHTA",
   "text": "What did you bring us? Show everyone.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L8",
   "start": 27.0,
   "end": 30.0,
   "type": "action",
   "speaker": null,
   "text": "Mira opens the box. A hand-painted silver frame.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L9",
   "start": 30.0,
   "end": 35.0,
   "type": "dialogue",
   "speaker": "LEELA MEHTA",
   "text": "Silver plate. From a girl who wants to marry into the Mehta family.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L10",
   "start": 35.0,
   "end": 39.0,
   "type": "action",
   "speaker": null,
   "text": "Leela drops the frame. It cracks on the marble floor. Guests laugh.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L11",
   "start": 39.0,
   "end": 42.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "My mother painted that frame.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L12",
   "start": 42.0,
   "end": 45.0,
   "type": "dialogue",
   "speaker": "LEELA MEHTA",
   "text": "Then your mother wasted her paint.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L13",
   "start": 45.0,
   "end": 49.0,
   "type": "action",
   "speaker": null,
   "text": "Mira looks at ARJUN MEHTA. He looks away and sips his champagne.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L14",
   "start": 49.0,
   "end": 52.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "Arjun, say something.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L15",
   "start": 52.0,
   "end": 56.0,
   "type": "dialogue",
   "speaker": "ARJUN",
   "text": "Mira, please. Not here. You're making a scene.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L16",
   "start": 56.0,
   "end": 60.0,
   "type": "action",
   "speaker": null,
   "text": "TANYA SETHI, Mira's best friend, steps forward and touches Arjun's arm.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L17",
   "start": 60.0,
   "end": 64.0,
   "type": "dialogue",
   "speaker": "TANYA",
   "text": "Maybe you should go home, Mira. For Arjun's sake.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L18",
   "start": 64.0,
   "end": 69.0,
   "type": "action",
   "speaker": null,
   "text": "Mira notices a smear of red lipstick on Arjun's white collar. The same deep red Tanya is wearing.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L19",
   "start": 69.0,
   "end": 72.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "(quietly) Since when do you wear red, Tanya?",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L20",
   "start": 72.0,
   "end": 75.0,
   "type": "action",
   "speaker": null,
   "text": "Tanya's smile freezes for half a second.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L21",
   "start": 75.0,
   "end": 79.0,
   "type": "dialogue",
   "speaker": "LEELA MEHTA",
   "text": "Enough. Security, show the gold digger out.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L22",
   "start": 79.0,
   "end": 83.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "I never asked your son for a single rupee.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L23",
   "start": 83.0,
   "end": 86.0,
   "type": "action",
   "speaker": null,
   "text": "Leela slaps Mira hard across the face. The music stops.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L24",
   "start": 86.0,
   "end": 90.0,
   "type": "dialogue",
   "speaker": "LEELA MEHTA",
   "text": "Girls like you always say that.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L25",
   "start": 90.0,
   "end": 95.0,
   "type": "action",
   "speaker": null,
   "text": "Silence. Mira touches her cheek. A gold locket engraved \"V.R.\" slips out from under her blouse.",
   "scene_id": 1,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L26",
   "start": 95.0,
   "end": 97.0,
   "type": "scene",
   "speaker": null,
   "text": "EXT. MEHTA MANSION - FRONT STEPS - NIGHT",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L27",
   "start": 97.0,
   "end": 102.0,
   "type": "action",
   "speaker": null,
   "text": "Mira walks out into the rain, barefoot, holding the cracked frame.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L28",
   "start": 102.0,
   "end": 107.0,
   "type": "action",
   "speaker": null,
   "text": "A black Rolls-Royce pulls up. A grey-haired man in a dark suit steps out with an umbrella.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L29",
   "start": 107.0,
   "end": 111.0,
   "type": "dialogue",
   "speaker": "HARISH DESAI",
   "text": "Miss Kapoor? My name is Harish Desai.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L30",
   "start": 111.0,
   "end": 113.0,
   "type": "dialogue",
   "speaker": "MIRA",
   "text": "I don't know you.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L31",
   "start": 113.0,
   "end": 118.0,
   "type": "dialogue",
   "speaker": "HARISH DESAI",
   "text": "No. But I have been looking for you for twenty-two years.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L32",
   "start": 118.0,
   "end": 121.0,
   "type": "action",
   "speaker": null,
   "text": "He holds the umbrella over her.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L33",
   "start": 121.0,
   "end": 124.0,
   "type": "dialogue",
   "speaker": "HARISH DESAI",
   "text": "It's about your father.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L34",
   "start": 124.0,
   "end": 126.0,
   "type": "action",
   "speaker": null,
   "text": "Mira freezes.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  },
  {
   "id": "E1_L35",
   "start": 126.0,
   "end": 128.0,
   "type": "direction",
   "speaker": null,
   "text": "CUT TO BLACK.",
   "scene_id": 2,
   "is_recap": false,
   "estimated_time": false
  }
 ],
